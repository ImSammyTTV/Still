{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "overlay",
  "description": "The capture overlay on each display",
  "windows": [
    "overlay-*"
  ],
  "permissions": [
    "allow-overlay-done",
    "allow-overlay-cancel",
    "allow-overlay-fullscreen",
    "allow-overlay-timer",
    "allow-overlay-purpose",
    "allow-overlay-window-mode",
    "allow-overlay-pointer"
  ]
}