{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "editor",
  "description": "Editor windows",
  "windows": [
    "editor-*"
  ],
  "permissions": [
    "allow-editor-save-file",
    "allow-library-get",
    "allow-settings-set",
    "allow-editor-save",
    "allow-editor-copy",
    "allow-editor-export",
    "allow-editor-drag",
    "allow-editor-pin",
    "allow-editor-open-image",
    "allow-cloud-upload-data",
    "core:window:allow-destroy"
  ]
}