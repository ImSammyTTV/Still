{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Still",
  "version": "1.2.16",
  "identifier": "app.still.desktop",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob: mediastream:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost data: blob:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$APPCACHE/still-tmp/**",
          "$DESKTOP/**",
          "$PICTURE/**"
        ]
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage",
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "GraphicsAndDesign",
    "shortDescription": "Screenshots, annotation and screen recording",
    "longDescription": "Capture an area, a window or the whole screen, annotate it and share it in seconds.",
    "publisher": "ImSammyTTV",
    "homepage": "https://github.com/ImSammyTTV/Still",
    "copyright": "\u00a9 ImSammyTTV",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYwNDU4N0NFNEJCNERCMkMKUldRczI3Ukx6b2RGWUNjSSs0UXUwZGVJejVVOEFmUFkxNCtlUkpMWE5kSDlCejJoZjlzVzhrL0gK",
      "endpoints": [
        "https://github.com/ImSammyTTV/Still/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}